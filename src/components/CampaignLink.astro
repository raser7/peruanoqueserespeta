---
import { Image } from 'astro:assets';
import type { Campaign } from '../data/campaigns';

interface Props { campaign: Omit<Campaign, 'image'> & { image: Campaign['image'] | string }; }
const { campaign } = Astro.props;
---

<a
  class:list={['campaign group relative grid min-h-0 overflow-hidden', `campaign--${campaign.theme}`]}
  href={campaign.href}
  target="_blank"
  rel="noopener noreferrer"
  aria-label={`Entra aquí al canal ${campaign.number} de Telegram (se abre en otra pestaña)`}
>
  <div class="campaign-copy relative z-10 flex min-w-0 flex-col items-center justify-center">
    <svg class="telegram-icon" aria-hidden="true" width="120" height="120" viewBox="0 0 24 24">
      <circle cx="12" cy="12" r="12" fill="#229ed9" />
      <path fill="white" d="m5.5 11.6 12.8-5c.6-.2 1.1.2.9.9L17 17.9c-.1.7-.6.9-1.2.5l-3.3-2.4-1.6 1.5c-.2.2-.4.4-.7.4l.2-3.4 6.2-5.6c.3-.3-.1-.4-.4-.2l-7.7 4.9-3.2-1c-.7-.2-.7-.7.2-1Z" />
    </svg>
    <span class="campaign-cta uppercase">{campaign.cta}</span>
  </div>
  <div class="campaign-visual relative min-h-0 min-w-0">
    {typeof campaign.image === 'string' ? (
      <img class="campaign-photo h-full w-full" src={campaign.image} alt={campaign.imageAlt} width="900" height="900" loading="eager" decoding="async" />
    ) : <Image
      class="campaign-photo h-full w-full object-cover"
      src={campaign.image}
      alt={campaign.imageAlt}
      widths={[240, 400, 640, 900]}
      sizes="(min-width: 1024px) 28vw, (max-height: 500px) and (orientation: landscape) 22vw, 42vw"
      format="webp"
      quality={80}
      loading="eager"
      decoding="async"
    />}
  </div>
</a>
